# Template konfigurasi untuk deploy/compose.yaml.
# Salin ke deploy/.env lalu isi nilainya. Jangan commit deploy/.env.

# --- PostgreSQL -------------------------------------------------
POSTGRES_USER=elvan
POSTGRES_PASSWORD=ganti-dengan-password-acak
POSTGRES_DB=elvan_catalog

# --- Situs -----------------------------------------------------
# Image situs statis FE (dibangun dari repo FE, lihat deploy/README.md §7).
# Untuk uji lokal: build dengan `docker build -f deploy/Dockerfile -t elvan-web:dev .`
# di repo FE. Untuk VPS: tag dari registry, mis.
#   WEB_IMAGE=ghcr.io/<owner>/elvan-web:1.4.0
WEB_IMAGE=elvan-web:dev

# --- Image API (repo BE) ---------------------------------------
# Di VPS, kedua nilai ini ditulis otomatis oleh .github/workflows/deploy.yml
# repo BE saat deploy (tag `sha-<commit>`). Default di bawah hanya untuk build
# lokal: `docker compose up --build api`.
API_IMAGE=elvan-api:dev
MIGRATE_IMAGE=elvan-api-migrate:dev

# Domain asli yang dilayani Caddy (mis. katalog.example.com). Caddy hanya
# mengaktifkan TLS otomatis kalau ada hostname di sini; ":443" polos TIDAK
# mendapat sertifikat. DNS A/AAAA harus menunjuk ke VPS ini dan port 80 + 443
# terbuka (port 80 dipakai ACME challenge + redirect ke HTTPS).
# Uji lokal tanpa TLS: SITE_ADDRESS=":80" lalu akses http://localhost.
SITE_ADDRESS="katalog.example.com"
SITE_EMAIL=admin@example.com

# --- API -------------------------------------------------------
# production (default) | development. "development" melonggarkan aturan cookie
# di bawah supaya bisa diuji tanpa TLS; jangan dipakai di produksi.
APP_ENV=production
LOG_LEVEL=info
DB_MAX_CONNS=10

# Batas waktu (Fase 7).
DB_STATEMENT_TIMEOUT=10s
REQUEST_TIMEOUT=30s

# --- Sesi & CORS -----------------------------------------------
SESSION_TTL=168h
# Kosongkan untuk satu domain (host-only) — ini yang disarankan. Kalau diisi,
# isinya harus benar-benar cocok dengan host situs; kalau tidak, browser
# menolak cookie-nya dan gejalanya: login tampak berhasil (200) tapi /auth/me
# langsung 401.
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
# true wajib saat APP_ENV=production (divalidasi saat startup: API menolak
# start kalau false). Uji lokal: biarkan true lalu akses http://localhost
# (Chrome/Firefox mengizinkan cookie Secure di localhost), atau set
# APP_ENV=development + COOKIE_SECURE=false (perlu untuk Safari).
COOKIE_SECURE=true
# Origin eksak dipisah koma; kosong = CORS mati (satu domain, disarankan).
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_LOGIN=5/min

# --- ImageKit (opsional; tanpa ini endpoint media dinonaktifkan) ----
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
