# Salin ke .env lalu isi nilainya. Jangan commit .env (sudah di .gitignore).
# Semua nilai dibaca dan divalidasi saat startup (lihat internal/platform/config).

# development | production
APP_ENV="development"

# Alamat listen server
HTTP_ADDR=":8080"

# debug | info | warn | error
LOG_LEVEL="info"

# PostgreSQL (pgx). Wajib.
DATABASE_URL="postgres://USER:PASSWORD@localhost:5432/elvan_catalog_dev?sslmode=disable"
DB_MAX_CONNS="10"

# Test integrasi (opsional di lokal; di CI diset otomatis oleh workflow).
# Diutamakan di atas DATABASE_URL supaya test tidak menunjuk DB aplikasi;
# sebaiknya arahkan ke database terpisah, mis. elvan_catalog_test.
TEST_DATABASE_URL="postgres://USER:PASSWORD@localhost:5432/elvan_catalog_test?sslmode=disable"

# ImageKit (hanya dibutuhkan modul media, Fase 5)
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT=""

# Sesi
SESSION_TTL="168h"
AUTH_TRANSPORT="cookie"       # cookie | bearer
COOKIE_DOMAIN=""              # kosong = host-only
COOKIE_SAMESITE="lax"         # lax | none | strict
COOKIE_SECURE="false"         # wajib true bila COOKIE_SAMESITE=none / di produksi

# CORS: daftar origin eksak dipisah koma. Kosong = CORS mati (satu domain).
CORS_ALLOWED_ORIGINS=""

# Rate limit login
RATE_LIMIT_LOGIN="5/min"
